{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/semaine", "dest": "/api/semaine.js" },
    { "src": "/api/marie-preremplir", "dest": "/api/marie-preremplir.js" },
    { "src": "/api/marie-ateliers", "dest": "/api/marie-ateliers.js" },
    { "src": "/api/rituels", "dest": "/api/rituels.js" },
    { "src": "/api/rituels-ajouter", "dest": "/api/rituels-ajouter.js" },
    { "src": "/api/rituels-remplacer", "dest": "/api/rituels-remplacer.js" },
    { "src": "/api/rituels-supprimer", "dest": "/api/rituels-supprimer.js" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/public/(.*)", "dest": "/public/$1" }
  ]
}
